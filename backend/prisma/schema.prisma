// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum TripStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
}

enum BookingType {
  HOTEL
  ATTRACTION
  TRANSPORT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransportType {
  BUS
  SHUTTLE
  PRIVATE
  FLIGHT
}

enum AttractionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntityType {
  HOTEL
  ATTRACTION
  DESTINATION
  TRANSPORT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  BOOKING
  BOOKING_CANCELLED
  TRIP
  TRIP_APPROVED
  TRIP_REJECTED
  ATTRACTION
  ATTRACTION_APPROVED
  ATTRACTION_REJECTED
  PAYMENT
  PAYMENT_FAILED
  REVIEW
  PROMO
  SYSTEM
  ADMIN_ALERT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  BOTH
}

// ============================================
// MODELS
// ============================================

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  password             String
  firstName            String
  lastName             String
  phone                String?
  avatar               String?
  role                 UserRole  @default(USER)
  status               UserStatus @default(ACTIVE)
  emailVerified        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relations
  trips                Trip[]
  bookings             Booking[]
  payments             Payment[]
  reviews              Review[]
  notifications        Notification[]
  notificationPreferences NotificationPreference?
  passwordResetTokens  PasswordResetToken[]
  auditLogsActor       AuditLog[] @relation("ActorAuditLogs")
  submittedAttractions Attraction[] @relation("SubmittedAttractions")

  @@index([email])
  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Destination {
  id                 String     @id @default(uuid())
  name               String
  slug               String     @unique
  description        String?
  shortDescription   String?
  image              String?
  region             String?
  featured           Boolean    @default(false)
  visible            Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  hotels             Hotel[]
  attractions        Attraction[]

  @@index([slug])
  @@index([visible])
  @@map("destinations")
}

model Hotel {
  id                 String     @id @default(uuid())
  name               String
  slug               String     @unique
  description        String?
  location           String?
  destinationId      String?
  pricePerNight      Decimal    @db.Decimal(10, 2)
  currency           String     @default("GHS")
  rating             Decimal    @default(0) @db.Decimal(2, 1)
  reviewCount        Int        @default(0)
  images             String[]   @default([])
  amenities          String[]   @default([])
  roomTypes          HotelRoomType[]
  featured           Boolean    @default(false)
  visible            Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  destination        Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  bookings           Booking[]
  reviews            Review[]

  @@index([destinationId])
  @@index([slug])
  @@index([visible])
  @@map("hotels")
}

model HotelRoomType {
  id                 String     @id @default(uuid())
  hotelId            String
  name               String
  capacity           Int
  price              Decimal    @db.Decimal(10, 2)
  amenities          String[]   @default([])
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  hotel              Hotel      @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@map("hotel_room_types")
}

model Trip {
  id                 String     @id @default(uuid())
  userId             String
  name               String
  startDate          DateTime?
  endDate            DateTime?
  destinations       String[]   @default([])
  transport          String?
  sideAttractions    String?
  activities         String?
  budget             Decimal?   @db.Decimal(10, 2)
  currency           String     @default("GHS")
  status             TripStatus @default(DRAFT)
  rejectionReason    String?
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  days               TripDay[]

  @@index([userId])
  @@index([status])
  @@map("trips")
}

model TripDay {
  id                 String     @id @default(uuid())
  tripId             String
  date               DateTime
  notes              String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  trip               Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  attractions        TripDayAttraction[]

  @@index([tripId])
  @@map("trip_days")
}

model Attraction {
  id                 String     @id @default(uuid())
  name               String
  slug               String     @unique
  description        String?
  shortDescription   String?
  location           String?
  destinationId      String?
  image              String?
  category           String?
  entryFee           Decimal    @default(0) @db.Decimal(10, 2)
  currency           String     @default("GHS")
  rating             Decimal    @default(0) @db.Decimal(2, 1)
  openingHours       String?
  status             AttractionStatus @default(APPROVED)
  submittedByUserId  String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  destination        Destination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)
  submittedBy        User?      @relation("SubmittedAttractions", fields: [submittedByUserId], references: [id], onDelete: SetNull)
  tripDayAttractions TripDayAttraction[]
  reviews            Review[]

  @@index([destinationId])
  @@index([slug])
  @@index([status])
  @@map("attractions")
}

model TripDayAttraction {
  id                 String     @id @default(uuid())
  tripDayId          String
  attractionId       String
  visitTime          String?
  notes              String?

  tripDay            TripDay    @relation(fields: [tripDayId], references: [id], onDelete: Cascade)
  attraction         Attraction @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@index([tripDayId])
  @@index([attractionId])
  @@map("trip_day_attractions")
}

model Booking {
  id                 String     @id @default(uuid())
  userId             String
  type               BookingType
  targetId           String
  checkIn            DateTime?
  checkOut           DateTime?
  guests             Int        @default(1)
  totalPrice         Decimal    @db.Decimal(10, 2)
  currency           String     @default("GHS")
  paymentRef         String?
  status             BookingStatus @default(PENDING)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel              Hotel?     @relation(fields: [targetId], references: [id], onDelete: SetNull, map: "booking_hotel_fk")
  payment            Payment?

  @@index([userId])
  @@index([type])
  @@map("bookings")
}

model Payment {
  id                 String     @id @default(uuid())
  bookingId          String?    @unique
  userId             String
  paystackRef        String     @unique
  amountGhs          Decimal    @db.Decimal(10, 2)
  amountUsd          Decimal?   @db.Decimal(10, 2)
  status             PaymentStatus @default(PENDING)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  booking            Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paystackRef])
  @@map("payments")
}

model TransportRoute {
  id                 String     @id @default(uuid())
  operator           String
  type               TransportType
  origin             String
  destination        String
  priceGhs           Decimal    @db.Decimal(10, 2)
  schedule           String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  reviews            Review[]

  @@index([origin])
  @@index([destination])
  @@map("transport_routes")
}

model Review {
  id                 String     @id @default(uuid())
  userId             String
  entityType         EntityType
  entityId           String
  rating             Int
  comment            String?
  status             ReviewStatus @default(PENDING)
  featured           Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  hotel              Hotel?     @relation(fields: [entityId], references: [id], map: "review_hotel_fk")
  attraction         Attraction? @relation(fields: [entityId], references: [id], map: "review_attraction_fk")
  transport          TransportRoute? @relation(fields: [entityId], references: [id], map: "review_transport_fk")

  @@index([userId])
  @@index([entityId])
  @@index([status])
  @@map("reviews")
}

model Notification {
  id                 String     @id @default(uuid())
  userId             String
  title              String
  message            String?
  type               NotificationType
  channel            NotificationChannel @default(IN_APP)
  isRead             Boolean    @default(false)
  readAt             DateTime?
  relatedId          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  // Relations
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                        String     @id @default(uuid())
  userId                    String     @unique
  emailBookingConfirmation  Boolean    @default(true)
  emailPaymentAlert         Boolean    @default(true)
  emailMarketingUpdates     Boolean    @default(false)
  emailTripRecommendations  Boolean    @default(true)
  smsBookingConfirmation    Boolean    @default(true)
  smsPaymentAlert           Boolean    @default(true)
  smsPromotions             Boolean    @default(false)
  pushNotifications         Boolean    @default(true)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  // Relations
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuditLog {
  id                 String     @id @default(uuid())
  actorId            String?
  action             String
  resourceType       String
  resourceId         String?
  ip                 String?
  createdAt          DateTime   @default(now())

  // Relations
  actor              User?      @relation("ActorAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([resourceType])
  @@map("audit_logs")
}
